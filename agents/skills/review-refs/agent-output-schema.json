{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubAgentReport",
  "description": "Review sub-agent JSON output",
  "type": "object",
  "required": ["agent", "files_checked", "findings", "positive"],
  "properties": {
    "agent": {
      "type": "string",
      "enum": ["correctness", "concurrency", "conventions", "style", "performance", "security", "tests", "typescript", "observability", "deps-supply-chain", "sql-data-access", "consistency", "transactions", "compatibility", "distributed-operations", "domain-invariants", "web-ui-architecture", "web-forms-validation", "web-accessibility", "web-frontend-performance"]
    },
    "files_checked": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "file", "line", "category", "problem", "code_before", "code_after", "requires_verification"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(CORR|CONC|CONV|STYL|PERF|SEC|CONS|TXN|TEST|TS|OBSV|COMPAT|DIST|DEPS|SQL|DOM|WARC|WFRM|WA11Y|WFPR)-[0-9]+$"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "category": { "type": "string" },
          "problem": { "type": "string" },
          "code_before": {
            "type": "string",
            "description": "Report Before snippet; empty only when code_snippet_unavailable is true."
          },
          "code_after": {
            "type": "string",
            "description": "Report After snippet; empty only when code_snippet_unavailable is true."
          },
          "code_snippet_unavailable": {
            "type": "boolean",
            "description": "True only when no honest single-site Before/After (cross-cutting, policy-only, artifact not in diff, etc.); then empty code_* and non-empty code_absence_note."
          },
          "code_absence_note": {
            "type": "string",
            "maxLength": 600,
            "description": "If waiver true: short English why fences omitted (shown in report). Else omit or empty."
          },
          "scope_status": {
            "type": "string",
            "enum": ["in_scope", "out_of_scope"],
            "description": "Optional in sub-agent output; final orchestrator classification after dedupe."
          },
          "scope_reason": {
            "type": "string",
            "maxLength": 600,
            "description": "Optional in sub-agent output; final orchestrator reason after dedupe."
          },
          "requires_verification": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "allOf": [
                { "required": ["code_snippet_unavailable"] },
                { "properties": { "code_snippet_unavailable": { "const": true } } }
              ]
            },
            "then": {
              "required": ["code_absence_note"],
              "properties": {
                "code_absence_note": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 600
                },
                "code_before": { "const": "" },
                "code_after": { "const": "" }
              }
            },
            "else": {
              "properties": {
                "code_before": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Minimal source excerpt for the report Before block."
                },
                "code_after": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Concrete fix (report After block)."
                }
              }
            }
          }
        ]
      }
    },
    "positive": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 5,
      "description": "Questions or residual risks when context missing or confidence too low to decide."
    }
  }
}
